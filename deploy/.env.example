JWT_SECRET=replace-this-with-a-long-random-secret
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

DEFAULT_KEY_LIMIT=3

XRAY_RELAY_HOST=127.0.0.1
XRAY_RELAY_PORT=22
XRAY_RELAY_USER=root
XRAY_SSH_PRIVATE_KEY_PATH=/run/secrets/xray_ssh_key
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json

# dry_run — без реального сервера; local — панель на relay-сервере; ssh — на отдельной машине
XRAY_MODE=dry_run
XRAY_PUBLIC_HOST=vpn.example.com
PUBLIC_BASE_URL=http://localhost:5173
