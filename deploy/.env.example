# Настройки для локальной разработки: cd server && go run ./cmd/xray-panel --env-file ../deploy/.env
# На сервере файл /etc/xray-panel/panel.env создаёт install_panel.sh.

DATABASE_URL=sqlite:///panel.db
JWT_SECRET=replace-this-with-a-long-random-secret
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
SUBSCRIPTION_TITLE=Personal

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
DEFAULT_KEY_LIMIT=3

# dry_run — ключи создаются в памяти, без сервера; local — панель стоит на relay-сервере рядом с Xray
XRAY_MODE=dry_run
XRAY_PUBLIC_HOST=vpn.example.com
